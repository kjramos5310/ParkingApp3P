# Plantilla de nginx. La imagen oficial ejecuta envsubst sobre los archivos de
# /etc/nginx/templates al arrancar, de modo que el mismo bundle sirve en
# docker compose (KONG_UPSTREAM=kong:8000) y en Kubernetes
# (KONG_UPSTREAM=kong-proxy:8000).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API: la SPA llama siempre al mismo origen y nginx reenvia al gateway.
    # En Kubernetes el Ingress intercepta /api antes de llegar aqui, asi que
    # este bloque solo se usa en docker compose.
    location /api/ {
        proxy_pass http://${KONG_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: sin buffering ni cierre por inactividad.
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Los assets llevan hash en el nombre: son inmutables.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html nunca se cachea: apunta a la version actual del bundle.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Enrutado del lado del cliente: toda ruta desconocida devuelve la SPA.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
